<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Disable IIS output caching -->
    <caching enabled="false" enableKernelCache="false" />
    
    <!-- Disable static file caching -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    
    <!-- Add response headers to prevent caching -->
    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="no-store, no-cache, must-revalidate, max-age=0" />
        <add name="Pragma" value="no-cache" />
        <add name="Expires" value="0" />
      </customHeaders>
    </httpProtocol>
    
    <!-- URL Rewrite rules if needed -->
    <rewrite>
      <outboundRules>
        <rule name="Add no-cache headers">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <action type="Rewrite" value="no-store, no-cache, must-revalidate, max-age=0" />
        </rule>
      </outboundRules>
    </rewrite>
  </system.webServer>
</configuration>